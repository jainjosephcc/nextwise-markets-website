{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nextwise-markets-website",
  "compatibility_date": "2026-08-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
